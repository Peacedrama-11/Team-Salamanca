# Local Linux / WSL / POSIX-shell reference; root .env is not loaded automatically.
# Copy to .env, replace connection details, then source it as shown in README.md.
# Use a dedicated development database. Never commit the populated .env file.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/futurique

# API port for Caddyfile.local. The frontend uses PORT=5173 in its own shell.
PORT=5000
NODE_ENV=development
BASE_PATH=/

# No RunPod or other AI credentials are used by the current application.
